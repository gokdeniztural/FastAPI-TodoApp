# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizle doldurun.
# ".env" dosyası .gitignore içindedir ve asla repoya commit edilmemelidir.

# JWT imzalama anahtarı. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""

# Veritabanı bağlantı dizesi.
# PostgreSQL örneği:
#   DATABASE_URL=postgresql://<kullanici>:<sifre>@localhost:5432/TodoApplicationDatabase
# Tanımlanmazsa uygulama otomatik olarak yerel bir SQLite dosyasına (./todos.db) düşer.
DATABASE_URL=""
